pipeline {
    agent any
    tools {
       maven 'Maven-3.8.1'
       jdk 'JDK-17'
    }
    stages {
        stage('Checkout') { 
            steps {
                git url: 'https://github.com/pathnex/sample-java-app.git'
            }
        }
       stage('complie') {
           steps {
               sh 'mnv clean compile'
           }
       }
      stage('Test') { 
          steps { 
              sh 'mnv test' 
          }      
      }
      stage ('package') {
          steps {
              sh 'mnv package'
          }
      }
    }   
