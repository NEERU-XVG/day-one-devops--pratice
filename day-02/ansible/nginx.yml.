---
- name: Install and start Nginx 
  hosts: all
  become: yes
  tasks: 
    - name: Install nginx 
      yum:
        name: nginx
        state: present
    - name: Enable nginx 
      service:
        name: nginx
        state: present 

    - name: Enable nginx 
      service:
        name: nginx
        state: started \
        enable:yes
